{VERSION=2.14}

{UNITS=ENGLISH LENGTH}

{BOARD C:\path\to\file\altium designer.HYP
}

{STACKUP
  (SIGNAL T=0.003937 P=0.000000 C=1.724e-8 L="Top Layer" M=COPPER)
  (DIELECTRIC T=0.035433 C=4.800000 L="Top Layer" M=FR-4)
  (SIGNAL T=0.003937 P=0.000000 C=1.724e-8 L="Bottom Layer" M=COPPER)
}

{DEVICES
  (? REF=U2 Name=zyx L="Top Layer")
  (? REF=  Name=xyz L="Top Layer")
}

{PADSTACK=0, 0.000000
  ("Top Layer", 1, 0.06, 0.06, 0, M)
}
{PADSTACK=1, 0.000000
  ("Top Layer", 2, 0.06, 0.04, 270.000000, M)
}
{PADSTACK=2, 0.022
  (MDEF, 0, 0.04, 0.04, 180.000000, M)
  (ADEF, 0, 0.06, 0.06, 90.000000, A)
}

{NET=VCC
  (SEG X1=1.0 Y1=-2.0 X2=3.0 Y2=-4.0 W=0.011 L="Bottom Layer")
  (PIN X=1.0 Y=2.0 R=R1.1 P=4)
  (PIN X=1.0 Y=2.0 R= .1 P=4)
  (VIA X=1.0 Y=2.0 P=12)
  (PIN X=1.0 Y=2.0 R=U1.16 P=8)
  (ARC X1=1.0 Y1=-2.0 X2=3.0 Y2=-4.0 XC=5.0 YC=-6.0 R=0.016 W=0.0049 L="Bottom Layer")
  {POLYGON T=POUR L="Bottom Layer" ID=1 X=1.0 Y=1.0
    (LINE X=1.0 Y=2.0)
    (LINE X=1.0 Y=2.0)
  }
  {POLYVOID ID=1 X=1.0 Y=2.0
    (LINE X=1.0 Y=2.0)
  }
  {POLYVOID ID=1 X=1.0 Y=2.0
    (LINE X=1.0 Y=2.0)
    (LINE X=1.0 Y=2.0)
  }
}
{END}
{KEY=1-1-1}
